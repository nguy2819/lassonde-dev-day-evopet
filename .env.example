# Copy to .env.local and fill in. Never commit real values.
#
# Leave the Supabase values empty to run in DEMO MODE (in-memory fictional data,
# persona sign-in, no database needed).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by `npm run db:seed`. Never expose to the browser or Vercel preview logs.
SUPABASE_SERVICE_ROLE_KEY=

# Password given to the seeded demo auth users (seed script only).
SEED_DEMO_PASSWORD=

# Keep the demo persona sign-in available even when Supabase is configured (e.g. for a pitch).
# Leave false in production.
ENABLE_DEMO_LOGIN=false
