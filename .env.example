# Copy to .env.local and fill in. Never commit real values.
#
# Leave DATABASE_URL empty to run in DEMO MODE (in-memory fictional data,
# persona sign-in, no database needed).

# --- Postgres ---
# Neon: Dashboard → Connect → copy the connection string (pooled is fine).
#   DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require
# Local without Docker: run `npm run db:local` and use
#   DATABASE_URL=postgresql://postgres@127.0.0.1:5433/postgres
DATABASE_URL=

# Connections per server instance. Use 1 for the local PGlite database.
DATABASE_POOL_MAX=5

# Password for the seeded demo accounts (npm run db:seed). At least 10 characters.
SEED_DEMO_PASSWORD=

# Show the demo persona buttons even when a database is configured (e.g. for a pitch).
# Leave false in production.
ENABLE_DEMO_LOGIN=false
